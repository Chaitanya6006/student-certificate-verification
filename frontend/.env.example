# Copy to frontend/.env and fill in. Never commit .env.
#
# Expected wallet network: Midnight Wallet must be connected to this network
# when using the dApp.
VITE_NETWORK=preview

# Deployed certificate contract address (from `npm run deploy`).
VITE_CONTRACT_ADDRESS=

# Optional: wallet extension name shown in error messages.
# VITE_WALLET_NAME=Midnight Wallet